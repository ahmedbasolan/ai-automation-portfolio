        "jsCode": "const htmlContent = $('Loop Over Items1').first().json.data;\n\nconst domain = $input.first().json.domain;\n\nconst emailRegex = new RegExp(`[a-zA-Z0-9._%+-]+@${domain.replace(/\\./g, '\\\\.')}`, 'g');\n\nconst emails = htmlContent.match(emailRegex) || [];\n\n// If no emails found, return ['nothing found']\nconst result = emails.length === 0\n    ? [{ email: 'nothing found' }]\n    : emails\n        .filter((email, index, self) => self.indexOf(email) === index) // Remove duplicates\n        .map(email => ({ email }));\n\nconsole.log(result);\n\nreturn { emails: result };\n\n\n\n"
